{
  "name": "10.children-games",
  "version": "1.0.0",
  "description": "一款专为 1-3 岁婴幼儿设计的 Electron 桌面键盘乱按游戏",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac zip"
  },
  "build": {
    "appId": "com.orime.booniebearssmasher",
    "productName": "熊出没森林探险",
    "directories": {
      "output": "release_build"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1"
  }
}
